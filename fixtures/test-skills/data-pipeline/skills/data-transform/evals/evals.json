{
  "skill_name": "data-transform",
  "evals": [
    {
      "id": 1,
      "name": "L1-转换类型理解",
      "prompt": "What transform types does the data-transform skill support? List them.",
      "level": "L1",
      "expectations": [
        "支持 flatten 转换",
        "支持 nest 转换",
        "支持 filter 转换",
        "支持 rename-fields 转换"
      ],
      "assertions": []
    },
    {
      "id": 2,
      "name": "L2-flatten转换",
      "prompt": "Flatten the nested JSON data in input.json and write the result to transformed.json.",
      "level": "L2",
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": 1, \"name\": \"Alice\", \"type\": \"user\", \"address\": {\"city\": \"NYC\", \"zip\": \"10001\"}}]"}
      ],
      "expectations": [
        "输出包含 metadata 头",
        "address 被展开为 address.city 和 address.zip",
        "包含 transformed_at 时间戳"
      ],
      "assertions": [
        {"name": "输出文件存在", "type": "FILE_EXISTS", "params": {"filename": "transformed.json"}},
        {"name": "包含 metadata", "type": "JSON_HAS_FIELD", "params": {"filename": "transformed.json", "field": "metadata"}},
        {"name": "包含 records", "type": "JSON_HAS_FIELD", "params": {"filename": "transformed.json", "field": "records"}},
        {"name": "metadata 包含 transform_type", "type": "JSON_HAS_FIELD", "params": {"filename": "transformed.json", "field": "metadata.transform_type"}}
      ]
    },
    {
      "id": 3,
      "name": "L2-保留原始字段",
      "prompt": "Filter the data in input.json to only include records where type is 'user' and write to transformed.json.",
      "level": "L2",
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": 1, \"name\": \"Alice\", \"type\": \"user\"}, {\"id\": 2, \"name\": \"Order1\", \"type\": \"order\"}, {\"id\": 3, \"name\": \"Bob\", \"type\": \"user\"}]"}
      ],
      "expectations": [
        "只保留了 type 为 user 的记录",
        "输出包含 metadata 头",
        "原始字段被保留"
      ],
      "assertions": [
        {"name": "输出文件存在", "type": "FILE_EXISTS", "params": {"filename": "transformed.json"}}
      ]
    }
  ]
}
