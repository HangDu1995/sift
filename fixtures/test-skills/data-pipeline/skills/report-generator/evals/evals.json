{
  "skill_name": "report-generator",
  "evals": [
    {
      "id": 1,
      "name": "L1-报告结构理解",
      "prompt": "What sections must a report generated by the report-generator skill include?",
      "level": "L1",
      "expectations": [
        "必须包含 Summary 部分",
        "必须包含 Data Quality 部分",
        "必须包含 Recommendations 部分",
        "必须同时输出 markdown 和 JSON 格式"
      ],
      "assertions": []
    },
    {
      "id": 2,
      "name": "L2-从transformed数据生成报告",
      "prompt": "Generate a summary report from the data in transformed.json. Write the markdown report to report.md and the JSON summary to report-summary.json.",
      "level": "L2",
      "fixtures": [
        {"path": "transformed.json", "content": "{\"metadata\": {\"source\": \"input.json\", \"transform_type\": \"flatten\", \"record_count\": 3}, \"records\": [{\"id\": 1, \"name\": \"Alice\", \"type\": \"user\"}, {\"id\": 2, \"name\": \"Order1\", \"type\": \"order\"}, {\"id\": 3, \"name\": \"Widget\", \"type\": \"product\"}]}"}
      ],
      "expectations": [
        "报告包含总记录数 3",
        "报告包含按 type 的分组统计",
        "生成了 report.md 文件",
        "生成了 report-summary.json 文件"
      ],
      "assertions": [
        {"name": "report.md 存在", "type": "FILE_EXISTS", "params": {"filename": "report.md"}},
        {"name": "report-summary.json 存在", "type": "FILE_EXISTS", "params": {"filename": "report-summary.json"}},
        {"name": "包含 total_records", "type": "JSON_HAS_FIELD", "params": {"filename": "report-summary.json", "field": "total_records"}},
        {"name": "包含 by_type", "type": "JSON_HAS_FIELD", "params": {"filename": "report-summary.json", "field": "by_type"}},
        {"name": "包含 quality_score", "type": "JSON_HAS_FIELD", "params": {"filename": "report-summary.json", "field": "quality_score"}}
      ]
    },
    {
      "id": 3,
      "name": "L2-空数据报告",
      "prompt": "Generate a summary report from the data in transformed.json. Write the markdown report to report.md and the JSON summary to report-summary.json.",
      "level": "L2",
      "fixtures": [
        {"path": "transformed.json", "content": "{\"metadata\": {\"source\": \"empty.json\", \"transform_type\": \"flatten\", \"record_count\": 0}, \"records\": []}"}
      ],
      "expectations": [
        "报告明确指出数据为空",
        "total_records 为 0",
        "没有捏造不存在的数据"
      ],
      "assertions": [
        {"name": "report.md 存在", "type": "FILE_EXISTS", "params": {"filename": "report.md"}},
        {"name": "report-summary.json 存在", "type": "FILE_EXISTS", "params": {"filename": "report-summary.json"}}
      ]
    }
  ]
}
