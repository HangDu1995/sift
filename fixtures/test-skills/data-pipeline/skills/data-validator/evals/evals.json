{
  "skill_name": "data-validator",
  "evals": [
    {
      "id": 1,
      "name": "L1-验证规则理解",
      "prompt": "You have a JSON file containing user records. Each record has id, name, and type fields. What validation rules would you apply based on the data-validator skill?",
      "level": "L1",
      "expectations": [
        "id 必须是正整数",
        "name 必须是非空字符串",
        "type 必须是 user/order/product 之一",
        "需要检查 SQL 注入模式"
      ],
      "assertions": []
    },
    {
      "id": 2,
      "name": "L2-有效数据验证",
      "prompt": "Validate the data in input.json and write a validation report.",
      "level": "L2",
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": 1, \"name\": \"Alice\", \"type\": \"user\"}, {\"id\": 2, \"name\": \"Bob\", \"type\": \"order\"}]"}
      ],
      "expectations": [
        "所有记录验证通过",
        "验证报告显示 valid_count 为 2",
        "验证报告显示 invalid_count 为 0"
      ],
      "assertions": [
        {"name": "报告文件存在", "type": "FILE_EXISTS", "params": {"filename": "validation-report.json"}},
        {"name": "报告包含 valid_count", "type": "JSON_HAS_FIELD", "params": {"filename": "validation-report.json", "field": "valid_count"}},
        {"name": "报告包含 errors", "type": "JSON_HAS_FIELD", "params": {"filename": "validation-report.json", "field": "errors"}}
      ]
    },
    {
      "id": 3,
      "name": "L2-无效数据验证",
      "prompt": "Validate the data in input.json and write a validation report.",
      "level": "L2",
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": -1, \"name\": \"\", \"type\": \"unknown\"}, {\"id\": 0, \"name\": \"test\"}]"}
      ],
      "expectations": [
        "检测到无效记录",
        "验证报告包含错误描述",
        "id 为负数被标记为错误"
      ],
      "assertions": [
        {"name": "报告文件存在", "type": "FILE_EXISTS", "params": {"filename": "validation-report.json"}},
        {"name": "有无效记录", "type": "CONTAINS_PATTERN", "params": {"pattern": "invalid_count", "path": "validation-report.json"}}
      ]
    }
  ]
}
