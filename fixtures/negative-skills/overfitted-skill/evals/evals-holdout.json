{
  "skill_name": "overfitted-skill",
  "evals": [
    {
      "id": 5,
      "name": "L1-错误处理能力",
      "prompt": "如果输入文件是损坏的，你的处理流程能处理吗？",
      "level": "L1",
      "expectations": [
        "描述了错误处理策略",
        "不会假设数据总是正确的",
        "提供了具体的错误类型和对应处理方法"
      ],
      "assertions": []
    },
    {
      "id": 6,
      "name": "L2-嵌套数据处理",
      "prompt": "帮我处理 input.json，其中有嵌套的 address 对象，需要展开",
      "level": "L2",
      "expectations": [
        "address 对象被展开",
        "address.city 和 address.zip 被提取为独立字段",
        "输出保持有效的 JSON 结构"
      ],
      "assertions": [
        {"name": "输出存在", "type": "FILE_EXISTS", "params": {"filename": "transformed.json"}}
      ],
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": 1, \"name\": \"Alice\", \"address\": {\"city\": \"NYC\", \"zip\": \"10001\"}}]"}
      ]
    },
    {
      "id": 7,
      "name": "L2-大文件处理",
      "prompt": "帮我处理 input.json，有 1000 条记录，需要过滤条件",
      "level": "L2",
      "expectations": [
        "能处理大量记录",
        "过滤结果正确",
        "不会因内存不足而失败"
      ],
      "assertions": [
        {"name": "输出存在", "type": "FILE_EXISTS", "params": {"filename": "filtered_output.json"}}
      ],
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": 1, \"status\": \"active\"}, {\"id\": 2, \"status\": \"inactive\"}, {\"id\": 3, \"status\": \"active\"}]"}
      ]
    }
  ]
}
