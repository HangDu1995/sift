{
  "skill_name": "overfitted-skill",
  "evals": [
    {
      "id": 1,
      "name": "L1-处理规则理解",
      "prompt": "我有一批 JSON 数据需要处理，你能告诉我处理流程吗？",
      "level": "L1",
      "expectations": [
        "输出必须包含 metadata 字段",
        "输出必须包含 records 数组",
        "输出需要 transform_type 字段"
      ],
      "assertions": []
    },
    {
      "id": 2,
      "name": "L2-数据转换",
      "prompt": "帮我处理 input.json 并输出结果",
      "level": "L2",
      "expectations": [
        "输出文件存在",
        "输出包含 metadata",
        "metadata 包含 transform_type",
        "输出包含 records",
        "输出文件使用 UTF-8 编码"
      ],
      "assertions": [
        {"name": "输出文件存在", "type": "FILE_EXISTS", "params": {"filename": "transformed.json"}},
        {"name": "输出包含 records", "type": "JSON_HAS_FIELD", "params": {"filename": "transformed.json", "field": "records"}},
        {"name": "输出包含 metadata", "type": "JSON_HAS_FIELD", "params": {"filename": "transformed.json", "field": "metadata"}}
      ],
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": 1, \"name\": \"Alice\", \"type\": \"user\"}]"}
      ]
    },
    {
      "id": 3,
      "name": "L2-数据验证",
      "prompt": "帮我校验 input.json 的数据合法性",
      "level": "L2",
      "expectations": [
        "验证 id 为正整数",
        "验证 name 为非空",
        "验证 type 为 user/order/product 之一",
        "包含 SQL 注入检测"
      ],
      "assertions": [
        {"name": "报告文件存在", "type": "FILE_EXISTS", "params": {"filename": "validation-report.json"}}
      ],
      "fixtures": [
        {"path": "input.json", "content": "[{\"id\": -1, \"name\": \"\", \"type\": \"invalid\"}]"}
      ]
    },
    {
      "id": 4,
      "name": "L2-报告生成",
      "prompt": "根据 transformed.json 生成汇总报告",
      "level": "L2",
      "expectations": [
        "报告文件存在",
        "报告包含记录数",
        "报告包含统计信息"
      ],
      "assertions": [
        {"name": "报告存在", "type": "FILE_EXISTS", "params": {"filename": "report.md"}}
      ],
      "fixtures": [
        {"path": "transformed.json", "content": "{\"metadata\": {\"transform_type\": \"filter\"}, \"records\": [{\"id\": 1, \"name\": \"Alice\"}]}"}
      ]
    }
  ]
}
